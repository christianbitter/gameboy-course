{
    "version": 4,
    "configurations": [
        {
            "name": "MSYS2 UCRT64 (gcc, C17)",
            "includePath": [
                "${workspaceFolder}/gb/include",
                "${workspaceFolder}/gb/src",
                "${workspaceFolder}/gb/tests"
            ],
            "defines": [],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64",
            "compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
            "browse": {
                "path": [
                    "${workspaceFolder}/gb"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "WSL or Linux (gcc, C17)",
            "includePath": [
                "${workspaceFolder}/gb/include",
                "${workspaceFolder}/gb/src",
                "${workspaceFolder}/gb/tests"
            ],
            "defines": [],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/gcc",
            "browse": {
                "path": [
                    "${workspaceFolder}/gb"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
