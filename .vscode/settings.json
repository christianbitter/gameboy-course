{
    "files.encoding": "utf8",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,

    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.workspaceParsingPriority": "medium",

    "files.associations": {
        "*.gb": "hexEditor.hexedit",
        "*.gbc": "hexEditor.hexedit",
        "*.sav": "hexEditor.hexedit",
        "*.srm": "hexEditor.hexedit",
        "*.ppm": "plaintext",
        "*.trace": "log"
    },

    "files.exclude": {
        "**/build": true,
        "**/__pycache__": true,
        "**/*.exe": true,
        "**/*.o": true,
        "**/*.obj": true
    },
    "search.exclude": {
        "**/build": true,
        "**/reference/tables": true
    },

    "editor.rulers": [80, 100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[markdown]": {
        "editor.wordWrap": "on",
        "files.trimTrailingWhitespace": false
    },

    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "python.analysis.extraPaths": ["${workspaceFolder}/tools"]
}
